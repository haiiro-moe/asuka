# Discord bot credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
CLIENT_SECRET=your-oauth2-client-secret

# The single guild this bot is locked to; it leaves all others.
GUILD_ID=your-guild-id

# Web UI / OAuth
OAUTH_REDIRECT=http://localhost:3000/auth/callback
SESSION_SECRET=change-me-to-a-long-random-string
WEB_PORT=3000
# Public base URL of the dashboard, used to build links posted in Discord (e.g. /club announce)
PUBLIC_URL=http://localhost:3000

# Storage
DATABASE_PATH=./asuka.sqlite

# Set to "production" to disable web HMR/dev console
NODE_ENV=development
